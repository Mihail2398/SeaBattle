<Window x:Class="NavalBattle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Морской Бой по сети" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#0C2538">
    <Grid>
        <Border x:Name="ConnectionMenu" Background="#F0F4F8" Width="300" Height="350" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Margin="20">
                <TextBlock Text="МОРСКОЙ БОЙ" FontSize="24" FontWeight="Bold" Foreground="#1A4A62" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Player 1 (Host/Client)" Background="#D0D9E0" TextAlignment="Center" Padding="5" Foreground="#333" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🌐" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtIp" Grid.Column="1" Text="127.0.0.1" Padding="5" FontSize="14"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚙" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtPort" Grid.Column="1" Text="8888" Padding="5" FontSize="14"/>
                </Grid>

                <RadioButton x:Name="RbHost" Content="Хост (Создать игру)" FontSize="14" Margin="0,0,0,10" IsChecked="True"/>
                <RadioButton x:Name="RbClient" Content="Клиент (Подключиться)" FontSize="14" Margin="0,0,0,20"/>

                <Button x:Name="BtnStart" Content="Кнопка начать" Background="#0C6B8B" Foreground="White" FontSize="16" FontWeight="Bold" Padding="10" BorderThickness="0" Click="BtnStart_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Grid x:Name="GameScreen" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <SolidColorBrush Color="#164D68"/>
            </Grid.Background>

            <Grid Grid.Column="0" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ТВОЕ ПОЛЕ" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <Border Grid.Row="1" BorderBrush="#3AA1C2" BorderThickness="2" Background="#0A324A" Opacity="0.9">
                    <UniformGrid x:Name="MyGrid" Rows="10" Columns="10" />
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border x:Name="TurnIndicatorPanel" Background="#1D7151" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtTurn" Text="ОЖИДАНИЕ..." Foreground="White" FontWeight="Bold" TextAlignment="Center"/>
                </Border>
                <TextBlock Text="Счет:" Foreground="White" TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtMyScore" Text="0" FontSize="24" FontWeight="Bold" Foreground="White" TextAlignment="Center" Margin="0,0,0,20"/>

                <Border Background="#A44040" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                    <TextBlock Text="ХОД ПРОТИВНИКА" Foreground="White" FontWeight="Bold" TextAlignment="Center" FontSize="10"/>
                </Border>
                <TextBlock Text="Счет:" Foreground="White" TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtEnemyScore" Text="0" FontSize="24" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Column="2" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ПОЛЕ ПРОТИВНИКА" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <Border Grid.Row="1" BorderBrush="#3AA1C2" BorderThickness="2" Background="#0A324A" Opacity="0.9">
                    <UniformGrid x:Name="EnemyGrid" Rows="10" Columns="10" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>